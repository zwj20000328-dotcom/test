{
  "name": "gomoku-game",
  "version": "1.0.0",
  "description": "五子棋游戏 - C++后端 + Vue前端",
  "scripts": {
    "dev": "concurrently \"node backend/server.js\" \"cd frontend && npm run dev\"",
    "dev:server": "node backend/server.js",
    "dev:client": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "node backend/server.js",
    "build:cpp": "g++ -O2 -std=c++17 -o backend/server.exe backend/main.cpp -lws2_32"
  }
}
